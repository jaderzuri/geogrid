    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const claim = $('Atomically Claim Pending Task IDs').item.json;\nconst payload = $json.body ?? $json;\nconst task = Array.isArray(payload.tasks) ? payload.tasks[0] : null;\nconst rootCode = Number(payload.status_code);\nconst code = Number(task?.status_code ?? payload.status_code);\nconst message = typeof (task?.status_message ?? payload.status_message) === 'string' ? (task?.status_message ?? payload.status_message) : null;\nconst pendingCodes = new Set([20100, 40601, 40602]);\nconst errorCategories = { 40000: 'request_error', 40001: 'request_error', 40002: 'request_error', 40003: 'request_error', 40004: 'request_error', 40006: 'request_error', 40007: 'request_notice', 401: 'authentication_error', 40100: 'authentication_error', 40101: 'technical_error', 40103: 'technical_error', 40104: 'authentication_error', 40105: 'task_unavailable', 40106: 'partial_results', 40107: 'technical_error', 402: 'insufficient_balance', 40200: 'insufficient_balance', 40201: 'access_denied', 40202: 'rate_limit', 40203: 'budget_limit', 40205: 'duplicate_task_limit', 40206: 'duplicate_task_limit', 40207: 'access_denied', 40209: 'rate_limit', 40210: 'insufficient_balance', 40400: 'request_error', 40401: 'task_unavailable', 40402: 'request_error', 40403: 'task_unavailable', 40404: 'request_error', 40405: 'request_error', 40406: 'request_error', 40407: 'request_error', 40408: 'request_error', 40501: 'request_error', 40502: 'request_error', 40503: 'request_error', 40504: 'request_error', 40505: 'request_error', 40506: 'request_error', 50000: 'technical_error', 50001: 'technical_error', 50301: 'technical_error', 50303: 'technical_error', 50304: 'technical_error', 50401: 'technical_error', 50402: 'technical_error' };\nlet results = [];\nif (task?.result?.[0]?.items && Array.isArray(task.result[0].items)) {\n  results = task.result[0].items.filter(i => i && i.type === 'maps_search').slice(0, 20).map(i => ({ name: i.title || 'Unknown business', cid: i.cid ? String(i.cid) : null, place_id: i.place_id || null, lat: i.latitude ?? null, lng: i.longitude ?? null, rating: i.rating?.value ?? null, reviews: i.rating?.votes_count ?? null, category: i.category || null, address: i.address || null, phone: typeof i.phone === 'string' ? i.phone.trim().slice(0, 100) || null : null, url: typeof i.url === 'string' ? i.url.trim().slice(0, 2000) || null : null, position: Number.isInteger(i.rank_absolute) && i.rank_absolute > 0 ? i.rank_absolute : null }));\n}\nlet state;\nlet pointStatus;\nlet errorCategory = null;\nlet errorMessage = null;\nif (pendingCodes.has(code)) {\n  state = 'pending';\n  pointStatus = 'pending';\n} else if (code === 40102 || (code === 20000 && results.length === 0)) {\n  state = 'no_results';\n  pointStatus = 'no_results';\n  errorCategory = 'no_results';\n} else if (code === 20000 && results.length > 0) {\n  state = 'done';\n  pointStatus = 'ok';\n} else {\n  state = 'failed';\n  pointStatus = 'error';\n  errorCategory = errorCategories[code] || 'technical_error';\n  errorMessage = message || (Number.isFinite(rootCode) ? `DataForSEO status ${rootCode}` : 'Invalid DataForSEO response');\n  results = [];\n}\nreturn { json: { request_id: claim.request_id, scan_id: claim.scan_id, business_id: claim.business_id, task_id: claim.task_id, row: claim.row_index, col: claim.col_index, lat: claim.latitude, lng: claim.longitude, poll_token: claim.claim_token, state, point_status: pointStatus, status_code: Number.isFinite(code) ? code : null, status_message: message, error_category: errorCategory, error_message: errorMessage, results } };"
      },

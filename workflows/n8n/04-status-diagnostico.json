        "jsCode": "const crypto = require('crypto');\nconst body = $json.body ?? $json;\nconst id = body.request_id;\nconst token = body.status_token;\nif (typeof id !== 'string' || !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(id) || typeof token !== 'string' || !/^[a-f0-9]{64}$/.test(token)) return { json: { valid: false } };\nreturn { json: { valid: true, request_id: id, token_hash: crypto.createHash('sha256').update(token).digest('hex') } };"
      },

    {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "const outcome = $('Associate and Classify task_post Response').item.json;\nconst build = $('Build Nine Standard Tasks').item.json;\nconst coords = new Map(build.points.map(p => [`${p.row}:${p.col}`, p]));\nconst points = outcome.task_results.filter(t => !t.task_id && Number.isInteger(t.status_code) && ((t.status_code >= 40000 && t.status_code < 50000) || [401, 402].includes(t.status_code))).map(t => { const p = coords.get(`${t.row}:${t.col}`); return { row: t.row, col: t.col, lat: p.lat, lng: p.lng, status: 'error', results: [], error: t.error_message || t.status_message || 'DataForSEO rejected the task', error_category: t.error_category || 'technical_error', api_status_code: t.status_code, api_status_message: t.status_message }; });\nreturn { json: { request_id: outcome.request_id, scan_id: build.scan_id, points, point_cells: points.map(p => ({ row_index: p.row, col_index: p.col })) } };"
        },

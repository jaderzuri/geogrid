      "id": "80d66b72-ea70-4abc-91b5-eecf57d59de9",
      "name": "Create Idempotent Smart Grid Scan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, 240],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SELECT_GEOGRID_BEARER_CREDENTIAL_AFTER_IMPORT",
          "name": "Smart Grid External API Bearer (configure after import)"
        }

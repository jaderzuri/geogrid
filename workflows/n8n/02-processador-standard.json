    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const scan = $json;\nconst request = $('Extract Exact Google Place ID').item.json;\nif (!scan.scan_id || scan.grid_size !== 3 || scan.spacing_km !== 1 || scan.total !== 9 || scan.points?.length !== 9 || scan.language_code !== 'pt') throw new Error('Smart Grid returned an unexpected external scan contract');\nconst tasks = scan.points.map(p => ({ keyword: scan.keyword, location_coordinate: `${p.lat},${p.lng},14z`, language_code: 'pt', priority: 1, depth: 20, tag: `${request.request_id}:${p.row}:${p.col}` }));\nreturn { json: { request_id: request.request_id, claim_token: request.claim_token, scan_id: scan.scan_id, business_id: scan.business_id, center: scan.center, points: scan.points.map(p => ({ row: p.row, col: p.col, lat: p.lat, lng: p.lng })), tasks } };"
      },
      "id": "40a9be28-aea5-4c44-880a-dab1697b06b4",
      "name": "Build Nine Standard Tasks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2240, 240],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT geogrid_prepare_tasks($1::uuid,$2::uuid,$3::text,$4::text,$5::double precision,$6::double precision,$7::jsonb) AS prepared;",
        "options": {
          "queryReplacement": "={{ [$json.request_id, $json.claim_token, $json.scan_id, $json.business_id, $json.center.lat, $json.center.lng, JSON.stringify($json.points)] }}"
        }
      },

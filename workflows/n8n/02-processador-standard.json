      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { URL } = require('url');\nconst r = $json;\nlet placeId = null;\nif (r.google_maps_url) {\n  const url = new URL(r.google_maps_url);\n  placeId = url.searchParams.get('query_place_id') || url.searchParams.get('place_id');\n  if (!placeId) {\n    const match = r.google_maps_url.match(/!1s(ChIJ[A-Za-z0-9_-]+)/);\n    if (match) placeId = match[1];\n  }\n}\nreturn { json: { ...r, place_id: placeId || null } };"
      },

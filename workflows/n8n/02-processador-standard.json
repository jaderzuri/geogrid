    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $('Extract Exact Google Place ID').item.json;\nconst p = $json;\nif (!p || !p.id || !p.location || !Number.isFinite(p.location.latitude) || !Number.isFinite(p.location.longitude)) throw new Error('Google Places did not return a verifiable location');\nconst name = p.displayName?.text || '';\nconst normalize = value => value.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]/g, '');\nconst requestedName = normalize(r.company_name);\nconst resolvedName = normalize(name);\nif (!requestedName || !resolvedName || !(resolvedName.includes(requestedName) || requestedName.includes(resolvedName))) throw new Error('Resolved Google Place name does not match the submitted company; manual review required');\nconst crypto = require('crypto');\nconst businessId = 'gplaces-' + crypto.createHash('sha256').update(p.id).digest('hex').slice(0, 40);\nreturn { json: { ...r, business_id: businessId, resolved_place_id: p.id, resolved_name: name, center_lat: p.location.latitude, center_lng: p.location.longitude, address: p.formattedAddress || `${r.city}, ${r.state}`, category: p.primaryTypeDisplayName?.text || null } };"
      },
      "id": "c0fd8818-8ee8-44a6-a0ea-48d0f98463d4",

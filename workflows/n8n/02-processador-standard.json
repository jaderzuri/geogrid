      "id": "3af55b31-243f-4f5f-8fd5-c596a9687fb9",
      "name": "Paid DataForSEO task_post - No Automatic Retry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2760, 240],
      "credentials": {
        "httpBasicAuth": {
          "id": "SELECT_DATAFORSEO_BASIC_CREDENTIAL_AFTER_IMPORT",
          "name": "DataForSEO Basic Auth (configure after import)"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": false
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const response = $json.body ?? $json;\nconst build = $('Build Nine Standard Tasks').item.json;\nconst expected = build.tasks;\nconst code = Number(response.status_code);\nconst message = typeof response.status_message === 'string' ? response.status_message : null;\nconst categories = { 401: 'authentication_error', 40100: 'authentication_error', 40104: 'authentication_error', 402: 'insufficient_balance', 40200: 'insufficient_balance', 40201: 'access_denied', 40202: 'rate_limit', 40203: 'budget_limit', 40205: 'duplicate_task_limit', 40206: 'duplicate_task_limit', 40209: 'rate_limit', 40210: 'insufficient_balance', 40000: 'request_error', 40001: 'request_error', 40006: 'request_error', 50000: 'technical_error', 50301: 'technical_error', 50401: 'technical_error', 50402: 'technical_error' };\nlet mapped;\nif (code !== 20000 && !Array.isArray(response.tasks)) {\n  mapped = expected.map((t, i) => ({ row: build.points[i].row, col: build.points[i].col, task_id: null, status_code: code || null, status_message: message, cost: 0, error_category: categories[code] || 'technical_error', error_message: message || 'DataForSEO rejected task_post' }));\n} else {\n  const tasks = Array.isArray(response.tasks) ? response.tasks : [];\n  const byTag = new Map(tasks.map(t => [t.data?.tag || t.tag, t]).filter(([tag]) => tag));\n  mapped = expected.map((input, i) => {\n    let t = byTag.get(input.tag);\n    if (!t && tasks.length === expected.length) {\n      t = tasks.find(candidate => candidate.data?.location_coordinate === input.location_coordinate);\n    }\n    if (!t) return { row: build.points[i].row, col: build.points[i].col, task_id: null, status_code: null, status_message: 'Response could not be reliably associated with a grid point', cost: 0, error_category: 'technical_error', error_message: 'Missing task tag/coordinate; manual reconciliation required' };\n    const taskCode = Number(t.status_code);\n    return { row: build.points[i].row, col: build.points[i].col, task_id: t.id || null, status_code: Number.isFinite(taskCode) ? taskCode : null, status_message: t.status_message || message, cost: Number(t.cost || 0), error_category: categories[taskCode] || (t.id ? null : 'technical_error'), error_message: t.id ? null : (t.status_message || message || 'No DataForSEO task ID returned') };\n  });\n}\nreturn { json: { request_id: build.request_id, task_results: mapped, total_cost_usd: Number(response.cost ?? mapped.reduce((sum, t) => sum + t.cost, 0)) } };"
      },

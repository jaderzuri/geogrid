      "id": "459719b6-d8d1-46b9-9b65-2823f3a5db87",
      "name": "Resolve Exact Place Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 240],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SELECT_GOOGLE_PLACES_CREDENTIAL_AFTER_IMPORT",
